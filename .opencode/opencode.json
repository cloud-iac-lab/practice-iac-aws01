{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md"
  ],
  "mcp": {
    "timeout": {
      "startup": 60000,
      "execution": 300000
    },
    "servers": {
      "mysql-mcp": {
        "type": "local",
        "command": ["npx", "-y", "@benborla29/mcp-server-mysql"],
        "environment": {
          "MYSQL_HOST": "127.0.0.1",
          "MYSQL_PORT": "3307",
          "MYSQL_USER": "root",
          "MYSQL_PASSWORD": "rootpassword",
          "MYSQL_DATABASE": "inventario_db"
        }
      },
      "browser-qa": {
        "type": "local",
        "command": ["npx", "-y", "@playwright/mcp"]
      }
    }
  },
  "agents": {
    "architect": {
      "description": "Diseña specs y ADRs antes del código. Solo escribe en specs/ y memory/.",
      "mode": "subagent",
      "tools": ["read", "grep", "glob", "write", "edit"],
      "temperature": 0.2
    },
    "implementer": {
      "description": "Escribe/edita código Terraform en infraestructure/. Puede correr init y validate, nunca apply.",
      "mode": "subagent",
      "tools": ["read", "grep", "glob", "write", "edit", "shell"],
      "temperature": 0.2
    },
    "validator": {
      "description": "Ejecuta los gates de calidad: fmt, validate, tflint, checkov y plan. NUNCA apply.",
      "mode": "subagent",
      "tools": ["read", "grep", "glob", "shell"],
      "temperature": 0
    },
    "reviewer": {
      "description": "Gate final: revisa cambios, actualiza MEMORY.md y decide aprobar. Solo lectura del código.",
      "mode": "subagent",
      "tools": ["read", "grep", "glob", "write", "edit"],
      "temperature": 0
    }
  }
}
